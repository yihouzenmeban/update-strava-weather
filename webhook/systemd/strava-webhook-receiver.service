[Unit]
Description=Strava webhook receiver (weather annotation trigger)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 "__HOOK_DIR__/receiver.py"
Restart=always
RestartSec=5
StandardOutput=append:__HOOK_DIR__/logs/receiver.log
StandardError=inherit

[Install]
# default.target is the boot target. The Muse guest boots a minimal
# default.target and never reaches multi-user.target.
WantedBy=default.target
